import { Theme } from "theme.slint";

export struct TermRun {
    col: int,
    width: int,
    text: string,
    fg: color,
    bg: color,
    has-bg: bool,
    bold: bool,
    italic: bool,
    underline: bool,
}

export struct TermLine {
    runs: [TermRun],
}

// Trecho selecionado numa linha da grade.
export struct SelRect {
    row: int,
    col: int,
    width: int,
}

// Um painel de terminal, com a posição já calculada pelo Rust (app/src/layout.rs).
export struct PaneView {
    id: int,
    x: length,
    y: length,
    width: length,
    height: length,
    lines: [TermLine],
    // Linha/coluna do cursor; -1 = escondido.
    cursor-row: int,
    cursor-col: int,
    selection: [SelRect],
    // Painel que recebe o teclado.
    active: bool,
    // O programa pediu atenção (sino ou notificação) e ninguém olhou ainda.
    attention: bool,
    // Linhas visíveis, linhas no histórico acima da tela e quantas linhas acima
    // do fim a tela está (0 = ao vivo): alimentam a barra de rolagem.
    rows: int,
    history: int,
    offset: int,
}

export component TerminalPane inherits Rectangle {
    in property <PaneView> pane;
    in property <length> cell-width;
    in property <length> cell-height;
    in property <length> pad;
    // Faixa reservada à direita para a barra de rolagem.
    in property <length> scrollbar-width;
    // O teclado está no terminal e este é o painel ativo: cursor cheio.
    in property <bool> focused;
    // Há mais de um painel: o ativo ganha uma borda.
    in property <bool> highlight;

    // Seleção com o mouse, em (linha, coluna) da grade; podem vir fora dos limites.
    callback select-start(int, int);
    callback select-move(int, int);
    callback select-end();
    callback select-word(int, int);
    // Botão direito: copia a seleção ou cola.
    callback secondary-click();
    // Linhas a rolar: positivo sobe no histórico.
    callback scroll-lines(int);
    // Posição absoluta no histórico: linhas acima do fim (barra de rolagem).
    callback scroll-to(int);
    // Roda do mouse: linhas (positivo sobe) e a célula sob o ponteiro, que vai para
    // o programa quando ele ligou o mouse.
    callback wheel(int, int, int);

    x: root.pane.x;
    y: root.pane.y;
    width: root.pane.width;
    height: root.pane.height;
    background: Theme.background;
    clip: true;

    // Célula sob um ponto do painel.
    pure function cell-row(y: length) -> int {
        floor((y - root.pad) / root.cell-height)
    }
    pure function cell-col(x: length) -> int {
        floor((x - root.pad) / root.cell-width)
    }

    mouse := TouchArea {
        mouse-cursor: text;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.select-start(root.cell-row(self.mouse-y), root.cell-col(self.mouse-x));
            } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.select-end();
            } else if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.secondary-click();
            }
        }
        moved => {
            root.select-move(root.cell-row(self.mouse-y), root.cell-col(self.mouse-x));
        }
        double-clicked => {
            root.select-word(root.cell-row(self.mouse-y), root.cell-col(self.mouse-x));
        }
        scroll-event(event) => {
            root.wheel(event.delta-y > 0 ? 3 : -3, root.cell-row(self.mouse-y), root.cell-col(self.mouse-x));
            accept
        }
    }

    grid := Rectangle {
        x: root.pad;
        y: root.pad;
        width: root.width - 2 * root.pad - root.scrollbar-width;
        height: root.height - 2 * root.pad;

        for line[r] in root.pane.lines: Rectangle {
            y: r * root.cell-height;
            height: root.cell-height;

            for run in line.runs: Rectangle {
                x: run.col * root.cell-width;
                width: run.width * root.cell-width;
                background: run.has-bg ? run.bg : transparent;

                Text {
                    x: 0;
                    width: parent.width;
                    height: parent.height;
                    text: run.text;
                    color: run.fg;
                    font-family: Theme.font-family;
                    font-size: Theme.font-size;
                    font-weight: run.bold ? 700 : 400;
                    font-italic: run.italic;
                    vertical-alignment: center;
                }

                if run.underline: Rectangle {
                    y: parent.height - 2px;
                    height: 1px;
                    background: run.fg;
                }
            }
        }

        for sel in root.pane.selection: Rectangle {
            x: sel.col * root.cell-width;
            y: sel.row * root.cell-height;
            width: sel.width * root.cell-width;
            height: root.cell-height;
            background: Theme.selection;
        }

        if root.pane.cursor-row >= 0: Rectangle {
            x: root.pane.cursor-col * root.cell-width;
            y: root.pane.cursor-row * root.cell-height;
            width: root.cell-width;
            height: root.cell-height;
            background: root.focused ? Theme.foreground.with-alpha(0.5) : transparent;
            border-width: root.focused ? 0 : 1px;
            border-color: Theme.muted;
        }
    }

    if root.pane.history > 0: scrollbar := Rectangle {
        x: root.width - root.scrollbar-width;
        y: 2px;
        width: root.scrollbar-width;
        height: root.height - 4px;
        // Fração do conteúdo (histórico + tela) que está visível.
        property <float> visible-fraction: root.pane.rows / (root.pane.history + root.pane.rows);
        // Espaço livre para o polegar andar dentro do trilho.
        property <length> free: self.height - thumb.height;

        // Clicar no trilho acima ou abaixo do polegar rola uma página.
        track-touch := TouchArea {
            clicked => {
                if self.mouse-y < thumb.y {
                    root.scroll-lines(max(1, root.pane.rows - 1));
                } else if self.mouse-y > thumb.y + thumb.height {
                    root.scroll-lines(-max(1, root.pane.rows - 1));
                }
            }
        }

        thumb := Rectangle {
            x: 2px;
            width: parent.width - 4px;
            height: max(24px, parent.height * parent.visible-fraction);
            // offset = histórico: topo; offset = 0: fim.
            y: parent.free * (root.pane.history - root.pane.offset) / root.pane.history;
            border-radius: 3px;
            background: thumb-touch.pressed ? #ffffff80 : (thumb-touch.has-hover || track-touch.has-hover ? #ffffff50 : #ffffff28);

            thumb-touch := TouchArea {
                // Onde o polegar foi agarrado, para ele não pular ao começar o arraste.
                property <length> grab;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        self.grab = self.mouse-y;
                    }
                }
                moved => {
                    // thumb.y + mouse-y é a posição do ponteiro no trilho, mesmo com o polegar se movendo.
                    root.scroll-to(root.pane.history - round(clamp((thumb.y + self.mouse-y - self.grab) / max(1px, scrollbar.free), 0, 1) * root.pane.history));
                }
            }
        }
    }

    if root.highlight && root.pane.active: Rectangle {
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.8);
    }

    if root.pane.attention: attention-border := Rectangle {
        border-width: 2px;
        border-color: Theme.attention;
    }
}
