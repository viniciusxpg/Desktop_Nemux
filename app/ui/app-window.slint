import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { MemoryPanel, MemoryEntry } from "memory-panel.slint";
import { TerminalPane, PaneView, TermLine, TermRun, SelRect } from "terminal-pane.slint";
import { SessionPicker, SessionItem } from "session-picker.slint";
import { ThemePicker, ThemeItem } from "theme-picker.slint";
import { SearchBar } from "search-bar.slint";
import { SettingsMenu, ShortcutsCard } from "settings-menu.slint";

export { MemoryEntry, PaneView, TermLine, TermRun, SelRect, SessionItem, ThemeItem, Theme }

// Divisória entre painéis, na área dos painéis; `vertical` = painéis lado a lado.
export struct DividerView {
    index: int,
    x: length,
    y: length,
    width: length,
    height: length,
    vertical: bool,
}

export struct TabInfo {
    title: string,
    // Saída nova enquanto a aba estava escondida.
    activity: bool,
    // Algum painel da aba pediu atenção (sino ou notificação).
    attention: bool,
}

// Uma aba. Todas têm a mesma largura (mesmas restrições, sem espaço entre elas):
// é isso que permite saber sobre qual aba o ponteiro está durante o arraste.
component TabButton inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    in property <bool> activity;
    in property <bool> attention;
    // Outra aba sendo arrastada para cá: -1 nada, 0 cai à esquerda, 1 à direita.
    in property <int> drop-side: -1;
    callback clicked();
    callback close();
    // Duplo clique abre o campo de nome; Enter (ou clicar fora) grava, Esc desiste.
    callback renamed(string);
    callback rename-done();
    // Arraste: índice da aba sob o ponteiro, contado a partir desta.
    callback drag-move(int);
    callback drag-end(int);

    property <bool> editing;
    property <bool> dragging;
    property <length> press-x;

    public function start-rename() {
        root.editing = true;
        name-input.text = root.title;
        name-input.focus();
        name-input.select-all();
    }

    function finish-rename(save: bool) {
        if !root.editing {
            return;
        }
        root.editing = false;
        if save {
            root.renamed(name-input.text);
        }
        root.rename-done();
    }

    // Quantas abas para a direita (ou esquerda, negativo) o ponteiro está.
    pure function slots(mouse-x: length) -> int {
        floor(mouse-x / root.width)
    }

    height: 32px;
    min-width: 120px;
    max-width: 220px;
    horizontal-stretch: 1;
    opacity: root.dragging ? 0.6 : 1;
    accessible-role: tab;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }
    background: active ? Theme.tab-active : (touch.has-hover ? Theme.tab-hover : Theme.tab-bar);

    // A aba é escolhida ao apertar o botão (não ao soltar), para o arraste já
    // começar com ela ativa.
    touch := TouchArea {
        pointer-event(event) => {
            if event.button != PointerEventButton.left {
                return;
            }
            if event.kind == PointerEventKind.down {
                root.press-x = self.mouse-x;
                root.dragging = false;
                root.clicked();
            } else if event.kind == PointerEventKind.up && root.dragging {
                root.dragging = false;
                root.drag-end(root.slots(self.mouse-x));
            }
        }
        moved => {
            if self.pressed && (root.dragging || abs(self.mouse-x - root.press-x) > 8px) {
                root.dragging = true;
                root.drag-move(root.slots(self.mouse-x));
            }
        }
        double-clicked => { root.start-rename(); }
    }

    if root.drop-side >= 0: Rectangle {
        x: root.drop-side == 0 ? 0 : parent.width - self.width;
        width: 2px;
        background: Theme.accent;
    }

    if active: Rectangle {
        y: 0;
        height: 2px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 4px;

        // Atenção: ponto maior na cor de aviso; novidade: ponto pequeno e discreto.
        if root.attention || root.activity: Rectangle {
            width: 10px;

            Rectangle {
                width: root.attention ? 8px : 6px;
                height: self.width;
                border-radius: self.width / 2;
                background: root.attention ? Theme.attention : Theme.muted;
                accessible-role: text;
                accessible-label: root.attention ? "Pede atenção" : "Saída nova";
            }
        }

        Text {
            text: root.title;
            color: root.active || root.attention ? Theme.foreground : Theme.muted;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        close-btn := Rectangle {
            width: 24px;
            border-radius: 4px;
            accessible-role: button;
            accessible-label: "Fechar aba " + root.title;
            accessible-action-default => { root.close(); }
            background: close-touch.has-hover ? Theme.tab-hover.brighter(30%) : transparent;

            Text {
                text: "×";
                color: Theme.muted;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            close-touch := TouchArea {
                clicked => { root.close(); }
            }
        }
    }

    name-box := Rectangle {
        visible: root.editing;
        x: 6px;
        y: 4px;
        width: parent.width - self.x - 30px;
        height: parent.height - 8px;
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.accent;
        background: Theme.background;

        name-input := TextInput {
            x: 6px;
            width: parent.width - 12px;
            color: Theme.foreground;
            vertical-alignment: center;
            single-line: true;
            // Só com o campo aberto (os testes o acham por aqui).
            accessible-label: root.editing ? "Nome da aba" : "";
            accepted => { root.finish-rename(true); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.finish-rename(false);
                    return accept;
                }
                reject
            }
            changed has-focus => {
                if !self.has-focus {
                    root.finish-rename(true);
                }
            }
        }
    }
}

// Botão da barra de abas que divide o painel ativo; o ícone mostra a divisória.
component SplitButton inherits Rectangle {
    in property <bool> side-by-side;
    in property <string> label;
    callback clicked();

    width: 32px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    background: touch.has-hover ? Theme.tab-hover : transparent;

    icon := Rectangle {
        width: 16px;
        height: 12px;
        border-width: 1.5px;
        border-radius: 2px;
        border-color: touch.has-hover ? Theme.foreground : Theme.muted;

        Rectangle {
            width: root.side-by-side ? 1.5px : parent.width;
            height: root.side-by-side ? parent.height : 1.5px;
            background: icon.border-color;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "Nemux";
    icon: @image-url("icons/nemux.svg");
    preferred-width: 1000px;
    preferred-height: 650px;
    background: Theme.background;

    in property <[TabInfo]> tabs;
    in property <int> active-tab;
    // Painéis da aba ativa e as divisórias entre eles.
    in property <[PaneView]> panes;
    in property <[DividerView]> dividers;

    // Painel de memória.
    in-out property <bool> memory-open;
    in property <[MemoryEntry]> memory-entries;
    in property <[string]> memory-projects;
    in-out property <int> memory-project-index;
    in-out property <string> memory-query;
    in property <string> memory-status;

    // Lista de sessões do Claude para retomar.
    in-out property <bool> sessions-open;
    in property <[SessionItem]> sessions;
    in-out property <string> sessions-query;
    in property <string> sessions-status;

    // Lista de temas prontos; escolher aplica e grava no config.toml.
    in-out property <bool> themes-open;
    in property <[ThemeItem]> themes;
    in property <int> theme-index;
    in property <string> themes-note;

    // Busca no histórico do painel ativo (Ctrl+Shift+F).
    in-out property <bool> search-open;
    in-out property <string> search-query;
    in property <string> search-status;

    // Menu da engrenagem e a lista de atalhos que ele abre.
    in-out property <bool> settings-open;
    in-out property <bool> shortcuts-open;
    in property <bool> restore-tabs: true;
    in property <bool> has-config;

    // Erro ao ler a configuração (ou ao gravar o tema); vazio quando não há.
    in property <string> config-error;

    // Tamanho de uma célula, medido com a própria fonte.
    out property <length> cell-width: measure.preferred-width / 10;
    out property <length> cell-height: measure.preferred-height;
    // Área onde os painéis são dispostos, e a margem interna de cada painel.
    out property <length> area-width: term-area.width;
    out property <length> area-height: term-area.height;
    // Canto da área dos painéis na janela (para achar o painel onde um arquivo caiu).
    out property <length> area-x: term-area.absolute-position.x;
    out property <length> area-y: term-area.absolute-position.y;
    // Arrastando arquivos sobre a janela.
    in property <bool> file-hover;
    out property <length> pane-pad: 6px;
    out property <length> scrollbar-width: 10px;

    callback new-tab();
    callback select-tab(int);
    callback close-tab(int);
    // Nome dado pelo usuário (vazio volta ao título do programa) e nova posição de uma aba.
    callback rename-tab(int, string);
    callback move-tab(int, int);
    // Devolve true se a tecla foi tratada.
    callback key-input(string, bool, bool, bool) -> bool;
    // A área dos painéis ou o tamanho da célula mudou.
    callback area-resized();
    callback split-right();
    callback split-down();
    // Os callbacks abaixo recebem primeiro o id do painel.
    // Linhas a rolar: positivo sobe no histórico.
    callback scroll-lines(int, int);
    // Posição no histórico vinda da barra de rolagem: linhas acima do fim.
    callback scroll-to(int, int);
    // Roda do mouse: linhas (positivo sobe), linha e coluna sob o ponteiro.
    callback wheel(int, int, int, int);
    // Arraste de uma divisória até um ponto da área dos painéis; duplo clique volta ao meio.
    callback divider-drag(int, length, length);
    callback divider-reset(int);
    // Seleção com o mouse, em (linha, coluna) da grade; podem vir fora dos limites.
    callback select-start(int, int, int);
    callback select-move(int, int);
    callback select-end();
    callback select-word(int, int, int);
    // Botão direito: copia a seleção ou cola.
    callback secondary-click(int);
    // Recarregar a lista da memória (painel aberto, busca ou filtro mudou).
    callback memory-refresh();
    callback memory-delete(int);
    // Reler as sessões do disco (lista aberta), só filtrar (busca mudou) e retomar uma delas.
    callback sessions-refresh();
    callback sessions-filter();
    callback session-open(int);
    callback config-error-dismissed();
    callback theme-chosen(int);
    // Fonte: +1 / -1 ponto; 0 volta ao padrão.
    callback font-zoom(int);
    callback restore-toggled(bool);
    callback open-config();
    // Busca: o texto mudou, ir para a ocorrência acima (true) ou abaixo, e fechar.
    callback search-changed(string);
    callback search-step(bool);
    callback search-closed();

    // Os widgets (campo de busca, lista) seguem o tema escuro do terminal.
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    changed area-width => { root.area-resized(); }
    changed area-height => { root.area-resized(); }
    changed cell-width => { root.area-resized(); }
    changed cell-height => { root.area-resized(); }

    public function focus-terminal() {
        key-handler.focus();
    }

    public function toggle-sessions() {
        root.sessions-open = !root.sessions-open;
        if root.sessions-open {
            root.sessions-query = "";
            root.sessions-refresh();
        } else {
            key-handler.focus();
        }
    }

    public function toggle-themes() {
        root.settings-open = false;
        root.themes-open = !root.themes-open;
        if !root.themes-open {
            key-handler.focus();
        }
    }

    public function toggle-settings() {
        root.themes-open = false;
        root.shortcuts-open = false;
        root.settings-open = !root.settings-open;
        if !root.settings-open {
            key-handler.focus();
        }
    }

    public function toggle-shortcuts() {
        root.settings-open = false;
        root.shortcuts-open = !root.shortcuts-open;
        if !root.shortcuts-open {
            key-handler.focus();
        }
    }

    // Abre a busca (ou volta a ela) com o texto todo selecionado, pronto para trocar.
    public function open-search() {
        if !root.search-open {
            root.search-open = true;
            if root.search-query != "" {
                root.search-changed(root.search-query);
            }
        }
        search-bar.focus-input();
    }

    public function close-search() {
        root.search-open = false;
        root.search-closed();
        key-handler.focus();
    }

    public function toggle-memory() {
        root.memory-open = !root.memory-open;
        if root.memory-open {
            root.memory-refresh();
        } else {
            key-handler.focus();
        }
    }

    // Aba sendo arrastada e a posição onde ela cairia (-1 = nenhum arraste).
    property <int> drag-from: -1;
    property <int> drag-to: -1;

    measure := Text {
        visible: false;
        text: "MMMMMMMMMM";
        font-family: Theme.font-family;
        font-size: Theme.font-size;
    }

    VerticalLayout {
        tab-bar := Rectangle {
            height: 32px;
            background: Theme.tab-bar;

            HorizontalLayout {

                for tab[i] in root.tabs: TabButton {
                    title: tab.title;
                    active: i == root.active-tab;
                    activity: tab.activity;
                    attention: tab.attention;
                    drop-side: root.drag-from >= 0 && root.drag-to == i && i != root.drag-from ? (i < root.drag-from ? 0 : 1) : -1;
                    clicked => {
                        root.select-tab(i);
                        key-handler.focus();
                    }
                    close => { root.close-tab(i); }
                    renamed(name) => { root.rename-tab(i, name); }
                    rename-done => { key-handler.focus(); }
                    drag-move(slots) => {
                        root.drag-from = i;
                        root.drag-to = clamp(i + slots, 0, root.tabs.length - 1);
                    }
                    drag-end(slots) => {
                        root.drag-from = -1;
                        root.drag-to = -1;
                        root.move-tab(i, clamp(i + slots, 0, root.tabs.length - 1));
                    }
                }

                new-tab-btn := Rectangle {
                    width: 36px;
                    accessible-role: button;
                    accessible-label: "Nova aba";
                    accessible-action-default => {
                        root.new-tab();
                        key-handler.focus();
                    }
                    background: new-touch.has-hover ? Theme.tab-hover : transparent;

                    Text {
                        text: "+";
                        color: Theme.foreground;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    new-touch := TouchArea {
                        clicked => {
                            root.new-tab();
                            key-handler.focus();
                        }
                    }
                }

                // Empurra os botões abaixo para a direita; as abas ficam perto do tamanho natural.
                Rectangle {
                    horizontal-stretch: 1000;
                }

                sessions-btn := Rectangle {
                    width: 80px;
                    accessible-role: button;
                    accessible-label: "Retomar sessão do Claude (Ctrl+Shift+R)";
                    accessible-action-default => { root.toggle-sessions(); }
                    background: sessions-touch.has-hover ? Theme.tab-hover : transparent;

                    Text {
                        text: "Sessões";
                        color: sessions-touch.has-hover ? Theme.foreground : Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    sessions-touch := TouchArea {
                        clicked => { root.toggle-sessions(); }
                    }
                }

                split-right-btn := SplitButton {
                    side-by-side: true;
                    label: "Dividir ao lado (Alt+Shift+=)";
                    clicked => {
                        root.split-right();
                        key-handler.focus();
                    }
                }

                split-down-btn := SplitButton {
                    side-by-side: false;
                    label: "Dividir abaixo (Alt+Shift+-)";
                    clicked => {
                        root.split-down();
                        key-handler.focus();
                    }
                }

                memory-btn := Rectangle {
                    width: 96px;
                    accessible-role: button;
                    accessible-label: "Memória";
                    accessible-action-default => { root.toggle-memory(); }
                    background: root.memory-open ? Theme.tab-active : (memory-touch.has-hover ? Theme.tab-hover : transparent);

                    Text {
                        text: "Memória";
                        color: root.memory-open ? Theme.foreground : Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    memory-touch := TouchArea {
                        clicked => { root.toggle-memory(); }
                    }
                }

                settings-btn := Rectangle {
                    property <bool> lit: root.settings-open || root.themes-open || root.shortcuts-open;
                    width: 36px;
                    accessible-role: button;
                    accessible-label: "Configurações";
                    accessible-action-default => { root.toggle-settings(); }
                    background: self.lit ? Theme.tab-active : (settings-touch.has-hover ? Theme.tab-hover : transparent);

                    Text {
                        text: "⚙";
                        color: parent.lit || settings-touch.has-hover ? Theme.foreground : Theme.muted;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    settings-touch := TouchArea {
                        clicked => { root.toggle-settings(); }
                    }
                }
            }
        }

        if root.config-error != "": config-banner := Rectangle {
            height: 28px;
            background: #5a1d1d;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 4px;

                Text {
                    text: root.config-error;
                    color: Theme.foreground;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 24px;
                    accessible-role: button;
                    accessible-label: "Fechar aviso da configuração";
                    accessible-action-default => { root.config-error-dismissed(); }
                    background: banner-close.has-hover ? #7a2d2d : transparent;

                    Text {
                        text: "×";
                        color: Theme.foreground;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    banner-close := TouchArea {
                        clicked => { root.config-error-dismissed(); }
                    }
                }
            }
        }

        body := HorizontalLayout {
            term-area := Rectangle {
                // Aparece nos espaços entre os painéis.
                background: Theme.divider;
                clip: true;

                key-handler := FocusScope {
                    // O foco vem dos cliques nos painéis; se o FocusScope tratasse o clique, a seleção não receberia o mouse.
                    focus-on-click: false;
                    key-pressed(event) => {
                        if event.modifiers.control && event.modifiers.shift && !event.modifiers.alt && (event.text == "m" || event.text == "M") {
                            root.toggle-memory();
                            return accept;
                        }
                        // Ctrl+= (ou Ctrl++), Ctrl+- e Ctrl+0: tamanho da fonte.
                        if event.modifiers.control && !event.modifiers.alt && (event.text == "=" || event.text == "+") {
                            root.font-zoom(1);
                            return accept;
                        }
                        if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && (event.text == "-" || event.text == "0") {
                            root.font-zoom(event.text == "-" ? -1 : 0);
                            return accept;
                        }
                        if event.modifiers.control && event.modifiers.shift && !event.modifiers.alt && (event.text == "f" || event.text == "F") {
                            root.open-search();
                            return accept;
                        }
                        if event.modifiers.control && event.modifiers.shift && !event.modifiers.alt && (event.text == "r" || event.text == "R") {
                            root.toggle-sessions();
                            return accept;
                        }
                        if root.key-input(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift) {
                            return accept;
                        }
                        reject
                    }
                }

                for pane in root.panes: TerminalPane {
                    pane: pane;
                    cell-width: root.cell-width;
                    cell-height: root.cell-height;
                    pad: root.pane-pad;
                    scrollbar-width: root.scrollbar-width;
                    focused: key-handler.has-focus && pane.active;
                    highlight: root.panes.length > 1;
                    select-start(row, col) => {
                        key-handler.focus();
                        root.select-start(pane.id, row, col);
                    }
                    select-move(row, col) => { root.select-move(row, col); }
                    select-end => { root.select-end(); }
                    select-word(row, col) => { root.select-word(pane.id, row, col); }
                    secondary-click => {
                        key-handler.focus();
                        root.secondary-click(pane.id);
                    }
                    scroll-lines(lines) => { root.scroll-lines(pane.id, lines); }
                    scroll-to(offset) => { root.scroll-to(pane.id, offset); }
                    wheel(lines, row, col) => { root.wheel(pane.id, lines, row, col); }
                }

                // Faixa de 8px sobre cada divisória de 2px, para ser fácil de pegar.
                for d in root.dividers: grip := Rectangle {
                    property <length> thickness: 8px;
                    x: d.vertical ? d.x + d.width / 2 - self.thickness / 2 : d.x;
                    y: d.vertical ? d.y : d.y + d.height / 2 - self.thickness / 2;
                    width: d.vertical ? self.thickness : d.width;
                    height: d.vertical ? d.height : self.thickness;

                    if grip-touch.has-hover || grip-touch.pressed: Rectangle {
                        x: d.vertical ? (parent.width - 2px) / 2 : 0;
                        y: d.vertical ? 0 : (parent.height - 2px) / 2;
                        width: d.vertical ? 2px : parent.width;
                        height: d.vertical ? parent.height : 2px;
                        background: Theme.accent;
                    }

                    grip-touch := TouchArea {
                        mouse-cursor: d.vertical ? MouseCursor.col-resize : MouseCursor.row-resize;
                        // grip.x + mouse-x é o ponteiro na área dos painéis, mesmo com a faixa se movendo.
                        moved => { root.divider-drag(d.index, grip.x + self.mouse-x, grip.y + self.mouse-y); }
                        double-clicked => { root.divider-reset(d.index); }
                    }
                }

                if root.file-hover: drop-hint := Rectangle {
                    background: Theme.background.with-alpha(0.75);
                    border-width: 2px;
                    border-color: Theme.accent;

                    Text {
                        text: "Solte para colar o caminho no painel";
                        color: Theme.foreground;
                        font-size: 16px;
                    }
                }

                search-bar := SearchBar {
                    x: parent.width - self.width - 16px;
                    y: 8px;
                    visible: root.search-open;
                    query <=> root.search-query;
                    status: root.search-status;
                    changed(text) => { root.search-changed(text); }
                    step(up) => { root.search-step(up); }
                    close => { root.close-search(); }
                }
            }

            if root.memory-open: memory-panel := MemoryPanel {
                entries: root.memory-entries;
                projects: root.memory-projects;
                project-index <=> root.memory-project-index;
                query <=> root.memory-query;
                status: root.memory-status;
                search-changed => { root.memory-refresh(); }
                delete(id) => { root.memory-delete(id); }
                close => { root.toggle-memory(); }
            }
        }
    }

    if root.themes-open: theme-picker := ThemePicker {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        themes: root.themes;
        current: root.theme-index;
        note: root.themes-note;
        anchor-right: settings-btn.x + settings-btn.width;
        anchor-top: tab-bar.height + 2px;
        choose(i) => { root.theme-chosen(i); }
        close => { root.toggle-themes(); }
    }

    if root.settings-open: settings-menu := SettingsMenu {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        anchor-right: settings-btn.x + settings-btn.width;
        anchor-top: tab-bar.height + 2px;
        restore-tabs: root.restore-tabs;
        has-config: root.has-config;
        themes => { root.toggle-themes(); }
        font-zoom(step) => { root.font-zoom(step); }
        restore-toggled(on) => { root.restore-toggled(on); }
        open-config => {
            root.toggle-settings();
            root.open-config();
        }
        shortcuts => { root.toggle-shortcuts(); }
        close => { root.toggle-settings(); }
    }

    if root.shortcuts-open: shortcuts-card := ShortcutsCard {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        anchor-right: settings-btn.x + settings-btn.width;
        anchor-top: tab-bar.height + 2px;
        close => { root.toggle-shortcuts(); }
    }

    if root.sessions-open: session-picker := SessionPicker {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        sessions: root.sessions;
        query <=> root.sessions-query;
        status: root.sessions-status;
        search-changed => { root.sessions-filter(); }
        open(i) => { root.session-open(i); }
        close => { root.toggle-sessions(); }
    }
}
