import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { MemoryPanel, MemoryEntry } from "memory-panel.slint";

export { MemoryEntry }

export struct TermRun {
    col: int,
    width: int,
    text: string,
    fg: color,
    bg: color,
    has-bg: bool,
    bold: bool,
    italic: bool,
    underline: bool,
}

export struct TermLine {
    runs: [TermRun],
}

// Trecho selecionado numa linha da grade.
export struct SelRect {
    row: int,
    col: int,
    width: int,
}

export struct TabInfo {
    title: string,
}

component TabButton inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    callback clicked();
    callback close();

    height: 32px;
    min-width: 120px;
    max-width: 220px;
    horizontal-stretch: 1;
    accessible-role: tab;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }
    background: active ? Theme.tab-active : (touch.has-hover ? Theme.tab-hover : Theme.tab-bar);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    if active: Rectangle {
        y: 0;
        height: 2px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 4px;

        Text {
            text: root.title;
            color: root.active ? Theme.foreground : Theme.muted;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        close-btn := Rectangle {
            width: 24px;
            border-radius: 4px;
            accessible-role: button;
            accessible-label: "Fechar aba " + root.title;
            accessible-action-default => { root.close(); }
            background: close-touch.has-hover ? Theme.tab-hover.brighter(30%) : transparent;

            Text {
                text: "×";
                color: Theme.muted;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            close-touch := TouchArea {
                clicked => { root.close(); }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Nemux";
    icon: @image-url("icons/nemux.svg");
    preferred-width: 1000px;
    preferred-height: 650px;
    background: Theme.background;

    in property <[TabInfo]> tabs;
    in property <int> active-tab;
    in property <[TermLine]> lines;
    // Linha/coluna do cursor; -1 = escondido.
    in property <int> cursor-row: -1;
    in property <int> cursor-col;
    in property <[SelRect]> selection;

    // Painel de memória.
    in-out property <bool> memory-open;
    in property <[MemoryEntry]> memory-entries;
    in property <[string]> memory-projects;
    in-out property <int> memory-project-index;
    in-out property <string> memory-query;
    in property <string> memory-status;

    // Tamanho de uma célula, medido com a própria fonte.
    out property <length> cell-width: measure.preferred-width / 10;
    out property <length> cell-height: measure.preferred-height;
    // Quantas colunas/linhas cabem na área do terminal.
    out property <int> grid-cols: max(1, floor((term-area.width - 2 * term-area.pad) / max(1px, root.cell-width)));
    out property <int> grid-rows: max(1, floor((term-area.height - 2 * term-area.pad) / max(1px, root.cell-height)));

    callback new-tab();
    callback select-tab(int);
    callback close-tab(int);
    // Devolve true se a tecla foi tratada.
    callback key-input(string, bool, bool, bool) -> bool;
    callback grid-resized(int, int);
    // Linhas a rolar: positivo sobe no histórico.
    callback scroll-lines(int);
    // Seleção com o mouse, em (linha, coluna) da grade; podem vir fora dos limites.
    callback select-start(int, int);
    callback select-move(int, int);
    callback select-end();
    callback select-word(int, int);
    // Botão direito: copia a seleção ou cola.
    callback secondary-click();
    // Recarregar a lista da memória (painel aberto, busca ou filtro mudou).
    callback memory-refresh();
    callback memory-delete(int);

    // Os widgets (campo de busca, lista) seguem o tema escuro do terminal.
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    changed grid-cols => { root.grid-resized(root.grid-cols, root.grid-rows); }
    changed grid-rows => { root.grid-resized(root.grid-cols, root.grid-rows); }

    public function focus-terminal() {
        key-handler.focus();
    }

    public function toggle-memory() {
        root.memory-open = !root.memory-open;
        if root.memory-open {
            root.memory-refresh();
        } else {
            key-handler.focus();
        }
    }

    // Célula sob um ponto da área do terminal.
    pure function cell-row(y: length) -> int {
        floor((y - term-area.pad) / root.cell-height)
    }
    pure function cell-col(x: length) -> int {
        floor((x - term-area.pad) / root.cell-width)
    }

    measure := Text {
        visible: false;
        text: "MMMMMMMMMM";
        font-family: Theme.font-family;
        font-size: Theme.font-size;
    }

    VerticalLayout {
        tab-bar := Rectangle {
            height: 32px;
            background: Theme.tab-bar;

            HorizontalLayout {

                for tab[i] in root.tabs: TabButton {
                    title: tab.title;
                    active: i == root.active-tab;
                    clicked => {
                        root.select-tab(i);
                        key-handler.focus();
                    }
                    close => { root.close-tab(i); }
                }

                new-tab-btn := Rectangle {
                    width: 36px;
                    accessible-role: button;
                    accessible-label: "Nova aba";
                    accessible-action-default => {
                        root.new-tab();
                        key-handler.focus();
                    }
                    background: new-touch.has-hover ? Theme.tab-hover : transparent;

                    Text {
                        text: "+";
                        color: Theme.foreground;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    new-touch := TouchArea {
                        clicked => {
                            root.new-tab();
                            key-handler.focus();
                        }
                    }
                }

                // Empurra o botão "Memória" para a direita; as abas ficam perto do tamanho natural.
                Rectangle {
                    horizontal-stretch: 1000;
                }

                memory-btn := Rectangle {
                    width: 96px;
                    accessible-role: button;
                    accessible-label: "Memória";
                    accessible-action-default => { root.toggle-memory(); }
                    background: root.memory-open ? Theme.tab-active : (memory-touch.has-hover ? Theme.tab-hover : transparent);

                    Text {
                        text: "Memória";
                        color: root.memory-open ? Theme.foreground : Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    memory-touch := TouchArea {
                        clicked => { root.toggle-memory(); }
                    }
                }
            }
        }

        body := HorizontalLayout {
            term-area := Rectangle {
                property <length> pad: 6px;
                background: Theme.background;
                clip: true;

                mouse := TouchArea {
                    mouse-cursor: text;
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                            key-handler.focus();
                            root.select-start(root.cell-row(self.mouse-y), root.cell-col(self.mouse-x));
                        } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                            root.select-end();
                        } else if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                            key-handler.focus();
                            root.secondary-click();
                        }
                    }
                    moved => {
                        root.select-move(root.cell-row(self.mouse-y), root.cell-col(self.mouse-x));
                    }
                    double-clicked => {
                        root.select-word(root.cell-row(self.mouse-y), root.cell-col(self.mouse-x));
                    }
                    scroll-event(event) => {
                        root.scroll-lines(event.delta-y > 0 ? 3 : -3);
                        accept
                    }
                }

                key-handler := FocusScope {
                    // O foco vem da TouchArea acima; se o FocusScope tratasse o clique, a seleção não receberia o mouse.
                    focus-on-click: false;
                    key-pressed(event) => {
                        if event.modifiers.control && event.modifiers.shift && !event.modifiers.alt && (event.text == "m" || event.text == "M") {
                            root.toggle-memory();
                            return accept;
                        }
                        if root.key-input(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift) {
                            return accept;
                        }
                        reject
                    }
                }

                grid := Rectangle {
                    x: term-area.pad;
                    y: term-area.pad;
                    width: root.grid-cols * root.cell-width;
                    height: root.grid-rows * root.cell-height;

                    for line[r] in root.lines: Rectangle {
                        y: r * root.cell-height;
                        height: root.cell-height;

                        for run in line.runs: Rectangle {
                            x: run.col * root.cell-width;
                            width: run.width * root.cell-width;
                            background: run.has-bg ? run.bg : transparent;

                            Text {
                                x: 0;
                                width: parent.width;
                                height: parent.height;
                                text: run.text;
                                color: run.fg;
                                font-family: Theme.font-family;
                                font-size: Theme.font-size;
                                font-weight: run.bold ? 700 : 400;
                                font-italic: run.italic;
                                vertical-alignment: center;
                            }

                            if run.underline: Rectangle {
                                y: parent.height - 2px;
                                height: 1px;
                                background: run.fg;
                            }
                        }
                    }

                    for sel in root.selection: Rectangle {
                        x: sel.col * root.cell-width;
                        y: sel.row * root.cell-height;
                        width: sel.width * root.cell-width;
                        height: root.cell-height;
                        background: Theme.selection;
                    }

                    if root.cursor-row >= 0: Rectangle {
                        x: root.cursor-col * root.cell-width;
                        y: root.cursor-row * root.cell-height;
                        width: root.cell-width;
                        height: root.cell-height;
                        background: key-handler.has-focus ? Theme.foreground.with-alpha(0.5) : transparent;
                        border-width: key-handler.has-focus ? 0 : 1px;
                        border-color: Theme.foreground;
                    }
                }
            }

            if root.memory-open: memory-panel := MemoryPanel {
                entries: root.memory-entries;
                projects: root.memory-projects;
                project-index <=> root.memory-project-index;
                query <=> root.memory-query;
                status: root.memory-status;
                search-changed => { root.memory-refresh(); }
                delete(id) => { root.memory-delete(id); }
                close => { root.toggle-memory(); }
            }
        }
    }
}
