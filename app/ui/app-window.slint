import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { MemoryPanel, MemoryEntry } from "memory-panel.slint";
import { TerminalPane, PaneView, TermLine, TermRun, SelRect } from "terminal-pane.slint";

export { MemoryEntry, PaneView, TermLine, TermRun, SelRect }

export struct TabInfo {
    title: string,
}

component TabButton inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    callback clicked();
    callback close();

    height: 32px;
    min-width: 120px;
    max-width: 220px;
    horizontal-stretch: 1;
    accessible-role: tab;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }
    background: active ? Theme.tab-active : (touch.has-hover ? Theme.tab-hover : Theme.tab-bar);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    if active: Rectangle {
        y: 0;
        height: 2px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 4px;

        Text {
            text: root.title;
            color: root.active ? Theme.foreground : Theme.muted;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        close-btn := Rectangle {
            width: 24px;
            border-radius: 4px;
            accessible-role: button;
            accessible-label: "Fechar aba " + root.title;
            accessible-action-default => { root.close(); }
            background: close-touch.has-hover ? Theme.tab-hover.brighter(30%) : transparent;

            Text {
                text: "×";
                color: Theme.muted;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            close-touch := TouchArea {
                clicked => { root.close(); }
            }
        }
    }
}

// Botão da barra de abas que divide o painel ativo; o ícone mostra a divisória.
component SplitButton inherits Rectangle {
    in property <bool> side-by-side;
    in property <string> label;
    callback clicked();

    width: 32px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    background: touch.has-hover ? Theme.tab-hover : transparent;

    icon := Rectangle {
        width: 16px;
        height: 12px;
        border-width: 1.5px;
        border-radius: 2px;
        border-color: touch.has-hover ? Theme.foreground : Theme.muted;

        Rectangle {
            width: root.side-by-side ? 1.5px : parent.width;
            height: root.side-by-side ? parent.height : 1.5px;
            background: icon.border-color;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "Nemux";
    icon: @image-url("icons/nemux.svg");
    preferred-width: 1000px;
    preferred-height: 650px;
    background: Theme.background;

    in property <[TabInfo]> tabs;
    in property <int> active-tab;
    // Painéis da aba ativa.
    in property <[PaneView]> panes;

    // Painel de memória.
    in-out property <bool> memory-open;
    in property <[MemoryEntry]> memory-entries;
    in property <[string]> memory-projects;
    in-out property <int> memory-project-index;
    in-out property <string> memory-query;
    in property <string> memory-status;

    // Tamanho de uma célula, medido com a própria fonte.
    out property <length> cell-width: measure.preferred-width / 10;
    out property <length> cell-height: measure.preferred-height;
    // Área onde os painéis são dispostos, e a margem interna de cada painel.
    out property <length> area-width: term-area.width;
    out property <length> area-height: term-area.height;
    out property <length> pane-pad: 6px;

    callback new-tab();
    callback select-tab(int);
    callback close-tab(int);
    // Devolve true se a tecla foi tratada.
    callback key-input(string, bool, bool, bool) -> bool;
    // A área dos painéis ou o tamanho da célula mudou.
    callback area-resized();
    callback split-right();
    callback split-down();
    // Os callbacks abaixo recebem primeiro o id do painel.
    // Linhas a rolar: positivo sobe no histórico.
    callback scroll-lines(int, int);
    // Seleção com o mouse, em (linha, coluna) da grade; podem vir fora dos limites.
    callback select-start(int, int, int);
    callback select-move(int, int);
    callback select-end();
    callback select-word(int, int, int);
    // Botão direito: copia a seleção ou cola.
    callback secondary-click(int);
    // Recarregar a lista da memória (painel aberto, busca ou filtro mudou).
    callback memory-refresh();
    callback memory-delete(int);

    // Os widgets (campo de busca, lista) seguem o tema escuro do terminal.
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    changed area-width => { root.area-resized(); }
    changed area-height => { root.area-resized(); }
    changed cell-width => { root.area-resized(); }
    changed cell-height => { root.area-resized(); }

    public function focus-terminal() {
        key-handler.focus();
    }

    public function toggle-memory() {
        root.memory-open = !root.memory-open;
        if root.memory-open {
            root.memory-refresh();
        } else {
            key-handler.focus();
        }
    }

    measure := Text {
        visible: false;
        text: "MMMMMMMMMM";
        font-family: Theme.font-family;
        font-size: Theme.font-size;
    }

    VerticalLayout {
        tab-bar := Rectangle {
            height: 32px;
            background: Theme.tab-bar;

            HorizontalLayout {

                for tab[i] in root.tabs: TabButton {
                    title: tab.title;
                    active: i == root.active-tab;
                    clicked => {
                        root.select-tab(i);
                        key-handler.focus();
                    }
                    close => { root.close-tab(i); }
                }

                new-tab-btn := Rectangle {
                    width: 36px;
                    accessible-role: button;
                    accessible-label: "Nova aba";
                    accessible-action-default => {
                        root.new-tab();
                        key-handler.focus();
                    }
                    background: new-touch.has-hover ? Theme.tab-hover : transparent;

                    Text {
                        text: "+";
                        color: Theme.foreground;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    new-touch := TouchArea {
                        clicked => {
                            root.new-tab();
                            key-handler.focus();
                        }
                    }
                }

                // Empurra os botões abaixo para a direita; as abas ficam perto do tamanho natural.
                Rectangle {
                    horizontal-stretch: 1000;
                }

                split-right-btn := SplitButton {
                    side-by-side: true;
                    label: "Dividir ao lado (Alt+Shift+=)";
                    clicked => {
                        root.split-right();
                        key-handler.focus();
                    }
                }

                split-down-btn := SplitButton {
                    side-by-side: false;
                    label: "Dividir abaixo (Alt+Shift+-)";
                    clicked => {
                        root.split-down();
                        key-handler.focus();
                    }
                }

                memory-btn := Rectangle {
                    width: 96px;
                    accessible-role: button;
                    accessible-label: "Memória";
                    accessible-action-default => { root.toggle-memory(); }
                    background: root.memory-open ? Theme.tab-active : (memory-touch.has-hover ? Theme.tab-hover : transparent);

                    Text {
                        text: "Memória";
                        color: root.memory-open ? Theme.foreground : Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    memory-touch := TouchArea {
                        clicked => { root.toggle-memory(); }
                    }
                }
            }
        }

        body := HorizontalLayout {
            term-area := Rectangle {
                // Aparece nos espaços entre os painéis.
                background: Theme.divider;
                clip: true;

                key-handler := FocusScope {
                    // O foco vem dos cliques nos painéis; se o FocusScope tratasse o clique, a seleção não receberia o mouse.
                    focus-on-click: false;
                    key-pressed(event) => {
                        if event.modifiers.control && event.modifiers.shift && !event.modifiers.alt && (event.text == "m" || event.text == "M") {
                            root.toggle-memory();
                            return accept;
                        }
                        if root.key-input(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift) {
                            return accept;
                        }
                        reject
                    }
                }

                for pane in root.panes: TerminalPane {
                    pane: pane;
                    cell-width: root.cell-width;
                    cell-height: root.cell-height;
                    pad: root.pane-pad;
                    focused: key-handler.has-focus && pane.active;
                    highlight: root.panes.length > 1;
                    select-start(row, col) => {
                        key-handler.focus();
                        root.select-start(pane.id, row, col);
                    }
                    select-move(row, col) => { root.select-move(row, col); }
                    select-end => { root.select-end(); }
                    select-word(row, col) => { root.select-word(pane.id, row, col); }
                    secondary-click => {
                        key-handler.focus();
                        root.secondary-click(pane.id);
                    }
                    scroll-lines(lines) => { root.scroll-lines(pane.id, lines); }
                }
            }

            if root.memory-open: memory-panel := MemoryPanel {
                entries: root.memory-entries;
                projects: root.memory-projects;
                project-index <=> root.memory-project-index;
                query <=> root.memory-query;
                status: root.memory-status;
                search-changed => { root.memory-refresh(); }
                delete(id) => { root.memory-delete(id); }
                close => { root.toggle-memory(); }
            }
        }
    }
}
