// Cores e fonte do Nemux, compartilhadas entre os arquivos .slint.
export global Theme {
    out property <color> background: #1e1e1e;
    out property <color> foreground: #cccccc;
    out property <color> tab-bar: #2b2b2b;
    out property <color> tab-active: #1e1e1e;
    out property <color> tab-hover: #383838;
    out property <color> muted: #8a8a8a;
    out property <color> accent: #3b78ff;
    out property <color> selection: #3b78ff66;
    out property <color> divider: #3a3a3a;
    out property <string> font-family: "Consolas";
    out property <length> font-size: 14px;
}
