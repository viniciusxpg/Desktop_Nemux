// Cores e fonte do Nemux, compartilhadas entre os arquivos .slint. Os valores
// abaixo são o padrão; a configuração do usuário os troca ao abrir (config.rs).
export global Theme {
    in-out property <color> background: #1e1e1e;
    in-out property <color> foreground: #cccccc;
    in-out property <color> tab-bar: #2b2b2b;
    in-out property <color> tab-active: #1e1e1e;
    in-out property <color> tab-hover: #383838;
    in-out property <color> muted: #8a8a8a;
    in-out property <color> accent: #3b78ff;
    in-out property <color> selection: #3b78ff66;
    in-out property <color> divider: #3a3a3a;
    // Painel ou aba que pediu atenção: o amarelo da paleta do terminal.
    in-out property <color> attention: #c19c00;
    in-out property <string> font-family: "Consolas";
    in-out property <length> font-size: 14px;
}
