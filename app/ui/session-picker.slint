import { LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct SessionItem {
    title: string,
    folder: string,
    when: string,
    // Gravada há pouco: provavelmente aberta em outra janela.
    active: bool,
    // A pasta ainda existe (sem ela não dá para retomar).
    available: bool,
}

// Botão pequeno de texto (exclusão e a confirmação dela).
component RowButton inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <color> text-color: Theme.foreground;
    callback clicked();

    border-radius: 4px;
    background: touch.has-hover ? Theme.tab-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        Text {
            text: root.text;
            color: root.text-color;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SessionRow inherits Rectangle {
    in property <SessionItem> item;
    // Mostrando "Excluir do disco?" no lugar do botão da lixeira.
    in-out property <bool> confirming;
    callback clicked();
    callback delete();

    border-radius: 6px;
    background: touch.has-hover && root.item.available ? Theme.tab-hover : transparent;
    accessible-role: button;
    accessible-label: "Retomar " + root.item.title;
    accessible-enabled: root.item.available;
    accessible-action-default => {
        if root.item.available {
            root.clicked();
        }
    }

    touch := TouchArea {
        mouse-cursor: root.item.available ? pointer : default;
        clicked => {
            if root.item.available {
                root.clicked();
            }
        }
    }

    HorizontalLayout {
        padding-right: 6px;
        spacing: 4px;

        VerticalLayout {
            padding: 10px;
            spacing: 4px;
            horizontal-stretch: 1;

            Text {
                text: root.item.title;
                color: root.item.available ? Theme.foreground : Theme.muted;
                font-weight: 600;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: root.item.available ? root.item.folder : root.item.folder + " (pasta não existe)";
                    color: Theme.muted;
                    font-size: 11px;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if root.item.active: Rectangle {
                    border-radius: 4px;
                    background: Theme.attention.transparentize(80%);

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;

                        Text {
                            text: "em uso";
                            color: Theme.attention;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: root.item.when;
                    color: Theme.muted;
                    font-size: 11px;
                }
            }
        }

        // Sessão em uso não se exclui (o Claude voltaria a gravar nela): no lugar
        // da lixeira, um espaço do mesmo tamanho, para as colunas não mudarem.
        if root.item.active: Rectangle {
            width: 28px;
        }

        if !root.confirming && !root.item.active: VerticalLayout {
            alignment: center;

            trash := Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 4px;
                background: trash-touch.has-hover ? Theme.tab-hover : transparent;
                accessible-role: button;
                accessible-label: "Excluir " + root.item.title;
                accessible-action-default => { root.confirming = true; }

                Image {
                    source: @image-url("icons/trash.svg");
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: trash-touch.has-hover ? Theme.danger : Theme.muted;
                }

                trash-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.confirming = true; }
                }
            }
        }

        if root.confirming: VerticalLayout {
            alignment: center;

            HorizontalLayout {
                spacing: 2px;

                Text {
                    text: "Excluir do disco?";
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                RowButton {
                    height: 26px;
                    text: "Excluir";
                    label: "Confirmar exclusão de " + root.item.title;
                    text-color: Theme.danger;
                    clicked => {
                        root.confirming = false;
                        root.delete();
                    }
                }

                RowButton {
                    height: 26px;
                    text: "Cancelar";
                    label: "Cancelar exclusão de " + root.item.title;
                    clicked => { root.confirming = false; }
                }
            }
        }
    }
}

// Lista das sessões do Claude Code salvas em disco, por cima da janela.
export component SessionPicker inherits Rectangle {
    in property <[SessionItem]> sessions;
    in-out property <string> query;
    in property <string> status;
    // Sessões cuja pasta não existe mais: o botão "Excluir as sem pasta" apaga todas.
    in property <int> orphans;
    property <bool> confirming-orphans;

    callback search-changed();
    // Índice na lista mostrada.
    callback open(int);
    // Apaga do disco (depois de confirmar na linha).
    callback delete(int);
    callback delete-orphans();
    callback close();

    background: #000000aa;

    init => {
        search.focus();
    }

    // Clicar fora do cartão fecha.
    TouchArea {
        clicked => { root.close(); }
    }

    card := Rectangle {
        width: min(680px, root.width - 32px);
        height: min(520px, root.height - 32px);
        border-radius: 10px;
        background: Theme.tab-bar;
        border-width: 1px;
        border-color: Theme.divider;

        // Engole os cliques dentro do cartão, para não fechar.
        TouchArea { }

        FocusScope {
            focus-on-click: false;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close();
                    return accept;
                }
                reject
            }

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    Text {
                        text: "Retomar sessão do Claude";
                        color: Theme.foreground;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    if root.orphans > 0 && !root.confirming-orphans: RowButton {
                        height: 28px;
                        text: "Excluir " + root.orphans + " sem pasta";
                        label: "Excluir as sessões sem pasta";
                        text-color: Theme.muted;
                        clicked => { root.confirming-orphans = true; }
                    }

                    if root.confirming-orphans: HorizontalLayout {
                        spacing: 2px;

                        Text {
                            text: root.orphans == 1 ? "Excluir 1 sessão sem pasta?" : "Excluir " + root.orphans + " sessões sem pasta?";
                            color: Theme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        RowButton {
                            height: 28px;
                            text: "Excluir";
                            label: "Confirmar exclusão das sessões sem pasta";
                            text-color: Theme.danger;
                            clicked => {
                                root.confirming-orphans = false;
                                root.delete-orphans();
                            }
                        }

                        RowButton {
                            height: 28px;
                            text: "Cancelar";
                            label: "Cancelar exclusão das sessões sem pasta";
                            clicked => { root.confirming-orphans = false; }
                        }
                    }

                    close-btn := Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 4px;
                        background: close-touch.has-hover ? Theme.tab-hover : transparent;
                        accessible-role: button;
                        accessible-label: "Fechar lista de sessões";
                        accessible-action-default => { root.close(); }

                        Text {
                            text: "×";
                            color: Theme.muted;
                            font-size: 18px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close-touch := TouchArea {
                            clicked => { root.close(); }
                        }
                    }
                }

                search := LineEdit {
                    placeholder-text: "Filtrar por título ou pasta…";
                    text <=> root.query;
                    edited => { root.search-changed(); }
                    // Enter abre a primeira da lista.
                    accepted => {
                        if root.sessions.length > 0 && root.sessions[0].available {
                            root.open(0);
                        }
                    }
                }

                ListView {
                    vertical-stretch: 1;

                    for item[i] in root.sessions: SessionRow {
                        item: item;
                        clicked => { root.open(i); }
                        delete => { root.delete(i); }
                    }
                }

                if root.sessions.length == 0: Text {
                    text: root.query == "" ? "Nenhuma sessão do Claude Code encontrada." : "Nenhuma sessão com esse filtro.";
                    color: Theme.muted;
                    horizontal-alignment: center;
                }

                status-text := Text {
                    text: root.status;
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
